---
import Logo from './Logo.astro';
import { copy, rich } from '../lib/copy';
import { feedbackHref, footerNav, joinHref, movement, repoUrl, whatsappHref } from '../data/site';

const { footer, site } = copy;
---

<footer class="footer">
  <div class="wrap footer-grid">
    <div class="footer-about">
      <Logo />
      <p>{footer.about}</p>
      <p set:html={rich(footer.partner)} />
    </div>
    <nav aria-label={footer.pages}>
      <h2>{footer.pages}</h2>
      <ul>
        {footerNav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href={joinHref}>{copy.nav.join}</a></li>
      </ul>
    </nav>
    <nav aria-label={footer.movement}>
      <h2>{footer.movement}</h2>
      <ul>
        {movement.map((item) => <li><a href={item.href} rel="noopener">{item.label}</a></li>)}
      </ul>
    </nav>
    <div>
      <h2>{footer.contact}</h2>
      <ul>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        {whatsappHref && <li><a href={whatsappHref} rel="noopener">{footer.whatsapp}</a></li>}
        <li>{footer.place}</li>
      </ul>
    </div>
    <div>
      <h2>{footer.feedback_heading}</h2>
      <p>{footer.feedback}</p>
      <ul>
        <li><a href={feedbackHref}>{footer.feedback_link}</a></li>
      </ul>
    </div>
  </div>
  <p class="wrap footer-legal" set:html={rich(footer.legal, { year: new Date().getFullYear(), repo: repoUrl })} />
</footer>
