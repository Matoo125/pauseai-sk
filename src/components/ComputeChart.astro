---
// Training compute of notable AI models over time, log scale.
// Rendered twice (wide and narrow) so the labels stay readable on a phone;
// CSS shows whichever fits.
import epoch from '../data/epoch.json';
import { flopText, scale, skBig, skDate, skDecimal, yearOf, type Tip } from '../lib/chart';

const { points, records, fromYear } = epoch.compute;
const recordNames = new Set(records);
const recordPoints = points.filter((p) => recordNames.has(p.name));
const latestRecord = recordPoints.at(-1)!;

// The handful of records worth naming on the plot itself; the rest are in the
// tooltip and the table.
const DIRECT_LABELS: Record<string, string> = {
  'AlphaGo Lee': 'AlphaGo',
  'GPT-3 175B (davinci)': 'GPT-3',
  'GPT-4 (Mar 2023)': 'GPT-4',
  [latestRecord.name]: latestRecord.name,
};

// Headline: the largest training run now against the largest known at the end of 2012.
const BASE_DATE = '2012-12-31';
const baseRecord = recordPoints.filter((p) => p.date <= BASE_DATE).at(-1)!;
const growth = latestRecord.flop / baseRecord.flop;
const doublingMonths = ((yearOf(latestRecord.date) - yearOf(BASE_DATE)) * 12) / Math.log2(growth);

const CONFIDENCE: Record<string, string> = {
  Confident: 'vysoká',
  Likely: 'stredná',
  Speculative: 'nízka',
};
const orgText = (org: string) => org.split(',').join(', ');

// Tooltip contents, written into the page once and shared by both variants.
const tips: Tip[] = points.map((p) => ({
  title: p.name,
  rows: [
    ['Tréning', `${flopText(p.flop)} FLOP`],
    ['Organizácia', orgText(p.org)],
    ['Zverejnené', skDate(p.date)],
  ],
}));
const tipsJson = JSON.stringify(tips).replace(/</g, '\\u003c');

const x0 = fromYear;
const x1 = Math.ceil(yearOf(epoch.source.latestModel));
const exps = points.map((p) => Math.log10(p.flop));
const e0 = Math.floor(Math.min(...exps));
const e1 = Math.ceil(Math.max(...exps));

const variants = [
  { id: 'wide', w: 960, h: 470, left: 50, right: 20, top: 18, bottom: 34, yearStep: 2, expStep: 2 },
  { id: 'narrow', w: 340, h: 380, left: 38, right: 10, top: 16, bottom: 32, yearStep: 4, expStep: 3 },
].map((v) => {
  const x = scale(x0, x1, v.left, v.w - v.right);
  const y = scale(e0, e1, v.h - v.bottom, v.top);
  const years = [];
  for (let year = x0; year <= x1; year += v.yearStep) years.push(year);
  const powers = [];
  for (let exp = e1; exp >= e0; exp -= v.expStep) powers.push(exp);
  const dots = points.map((p, i) => ({
    i,
    cx: +x(yearOf(p.date)).toFixed(1),
    cy: +y(Math.log10(p.flop)).toFixed(1),
    record: recordNames.has(p.name),
    label: DIRECT_LABELS[p.name],
  }));
  // The frontier: a step line through the records, held level until the next one.
  const steps = dots.filter((d) => d.record);
  const frontier =
    steps.map((d, i) => (i === 0 ? `M${d.cx},${d.cy}` : `H${d.cx}V${d.cy}`)).join('') +
    `H${x(yearOf(epoch.source.latestModel)).toFixed(1)}`;
  return { ...v, x, y, years, powers, dots, frontier };
});
---

<figure class="chart">
  <figcaption>
    <h3>
      Najväčší tréning AI dnes spotrebuje približne {skBig(growth)} ráz viac výpočtov než koncom roka 2012
    </h3>
    <p>
      Výpočty použité na tréning významných modelov AI, {fromYear} – {epoch.source.latestModel.slice(0, 4)}.
      Zvislá os je logaritmická, v operáciách s pohyblivou rádovou čiarkou (FLOP).
    </p>
  </figcaption>

  <ul class="legend">
    <li><span class="key key-dot key-record"></span>rekord v čase zverejnenia</li>
    <li><span class="key key-dot key-other"></span>ostatné významné modely</li>
  </ul>

  <div class="plot" data-plot="nearest">
    {
      variants.map((v) => (
        <svg
          class={`variant-${v.id}`}
          viewBox={`0 0 ${v.w} ${v.h}`}
          role="img"
          aria-label={`Bodový graf: tréningové výpočty významných modelov AI od roku ${fromYear}. Rekord vzrástol z ${flopText(baseRecord.flop)} FLOP koncom roka 2012 na ${flopText(latestRecord.flop)} FLOP (${latestRecord.name}). Hodnoty sú v tabuľke pod grafom.`}
        >
          <g class="grid">
            {v.powers.map((exp) => (
              <line x1={v.left} x2={v.w - v.right} y1={v.y(exp)} y2={v.y(exp)} />
            ))}
          </g>
          <g class="axis">
            {v.powers.map((exp) => (
              <text x={v.left - 8} y={v.y(exp) + 4} text-anchor="end">
                10<tspan dy="-5" font-size="9">{exp}</tspan>
              </text>
            ))}
            {v.years.map((year) => (
              <text x={v.x(year)} y={v.h - 10} text-anchor="middle">{year}</text>
            ))}
          </g>
          <g class="dots-other">
            {v.dots.filter((d) => !d.record).map((d) => <circle cx={d.cx} cy={d.cy} r="3" data-i={d.i} />)}
          </g>
          <path class="frontier" d={v.frontier} />
          <g class="dots-record">
            {v.dots.filter((d) => d.record).map((d) => <circle cx={d.cx} cy={d.cy} r="5" data-i={d.i} />)}
          </g>
          <g class="direct">
            {v.dots.filter((d) => d.label).map((d) => (
              <text x={d.cx - 9} y={d.cy - 7} text-anchor="end">{d.label}</text>
            ))}
          </g>
          <circle class="hover-ring" r="8" cx="-20" cy="-20" />
        </svg>
      ))
    }
    <script type="application/json" class="tips" set:html={tipsJson} />
    <div class="tip" hidden></div>
  </div>

  <p class="source">
    Rekord sa od konca roka 2012 zdvojnásobuje v priemere každých {skDecimal(doublingMonths, 0)} mesiacov
    (vlastný výpočet z prvej a poslednej hodnoty). Časť hodnôt sú odhady. Zdroj:{' '}
    <a href={epoch.source.url}>{epoch.source.name}</a>, {epoch.source.licence}, stav k {skDate(epoch.source.retrieved)}.
  </p>

  <details class="table-view">
    <summary>Zobraziť rekordy ako tabuľku</summary>
    <div class="table-scroll">
      <table>
        <thead>
          <tr><th>Model</th><th>Organizácia</th><th>Zverejnené</th><th class="num">Tréning (FLOP)</th><th>Istota odhadu</th></tr>
        </thead>
        <tbody>
          {recordPoints.map((p) => (
            <tr>
              <td>{p.name}</td>
              <td>{orgText(p.org)}</td>
              <td>{skDate(p.date)}</td>
              <td class="num">{flopText(p.flop)}</td>
              <td>{CONFIDENCE[p.confidence] ?? 'neuvedená'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="source">
      Všetkých {points.length} modelov je v <a href={epoch.source.csv}>pôvodnom súbore CSV</a>.
    </p>
  </details>
</figure>
