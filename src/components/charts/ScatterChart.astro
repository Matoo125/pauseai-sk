---
// Models over time as dots, with the running record picked out as a step line.
// Drawn at build time as plain SVG, twice (wide and narrow) so labels stay
// readable on a phone; CSS shows whichever fits. The three wrappers beside this
// file prepare the data and text for it.
import { copy } from '../../lib/copy';
import { records, scale, yearOf, type Tip } from '../../lib/chart';

interface Tick {
  value: number;
  /** Plain label, or the exponent to print as a power of ten. */
  label?: string;
  power?: number;
}

interface Props {
  title: string;
  subtitle: string;
  legendRecord: string;
  legendOther: string;
  aria: string;
  /** HTML under the plot: notes and the source line. */
  noteHtml: string;
  /** In date order. */
  points: { name: string; date: string; value: number; tip: Tip }[];
  /** Point name → the label to print beside it. Keep it to a handful. */
  labels?: Record<string, string>;
  log?: boolean;
  yDomain: [number, number];
  ticks: Tick[];
  /** Fewer ticks for the narrow variant; defaults to every other one. */
  ticksNarrow?: Tick[];
  xDomain: [number, number];
  /** Years between x labels: [wide, narrow]. */
  xStep?: [number, number];
  table: { head: { label: string; num?: boolean }[]; rows: string[][] };
}

const {
  title, subtitle, legendRecord, legendOther, aria, noteHtml, points, labels = {}, log = false,
  yDomain, ticks, ticksNarrow = ticks.filter((_, i) => i % 2 === 0), xDomain, xStep = [1, 1], table,
} = Astro.props;

const isRecord = records(points.map((p) => p.value));
const position = (value: number) => (log ? Math.log10(value) : value);
const tipsJson = JSON.stringify(points.map((p) => p.tip)).replace(/</g, '\\u003c');

const variants = [
  { id: 'wide', w: 960, h: 440, left: 62, right: 20, top: 18, bottom: 34, ticks, step: xStep[0] },
  { id: 'narrow', w: 340, h: 360, left: 50, right: 10, top: 16, bottom: 32, ticks: ticksNarrow, step: xStep[1] },
].map((v) => {
  const x = scale(xDomain[0], xDomain[1], v.left, v.w - v.right);
  const y = scale(position(yDomain[0]), position(yDomain[1]), v.h - v.bottom, v.top);
  const years = [];
  for (let year = xDomain[0]; year <= xDomain[1]; year += v.step) years.push(year);
  const dots = points.map((p, i) => ({
    i,
    cx: +x(yearOf(p.date)).toFixed(1),
    cy: +y(position(p.value)).toFixed(1),
    record: isRecord[i],
    label: labels[p.name],
  }));
  const steps = dots.filter((d) => d.record);
  const frontier = steps.map((d, i) => (i === 0 ? `M${d.cx},${d.cy}` : `H${d.cx}V${d.cy}`)).join('');
  return { ...v, x, yAt: (value: number) => y(position(value)), years, dots, frontier };
});
---

<figure class="chart">
  <figcaption>
    <h3>{title}</h3>
    <p>{subtitle}</p>
  </figcaption>

  <ul class="legend">
    <li><span class="key key-dot key-record"></span>{legendRecord}</li>
    <li><span class="key key-dot key-other"></span>{legendOther}</li>
  </ul>

  <div class="plot" data-plot="nearest">
    {
      variants.map((v) => (
        <svg class={`variant-${v.id}`} viewBox={`0 0 ${v.w} ${v.h}`} role="img" aria-label={aria}>
          <g class="grid">
            {v.ticks.map((tick) => <line x1={v.left} x2={v.w - v.right} y1={v.yAt(tick.value)} y2={v.yAt(tick.value)} />)}
          </g>
          <g class="axis">
            {v.ticks.map((tick) => (
              <text x={v.left - 8} y={v.yAt(tick.value) + 5} text-anchor="end">
                {tick.power === undefined ? tick.label : <Fragment>10<tspan dy="-5" font-size="9">{tick.power}</tspan></Fragment>}
              </text>
            ))}
            {v.years.map((year) => <text x={v.x(year)} y={v.h - 10} text-anchor="middle">{year}</text>)}
          </g>
          <g class="dots-other">
            {v.dots.filter((d) => !d.record).map((d) => <circle cx={d.cx} cy={d.cy} r="3.5" data-i={d.i} />)}
          </g>
          <path class="frontier" d={v.frontier} />
          <g class="dots-record">
            {v.dots.filter((d) => d.record).map((d) => <circle cx={d.cx} cy={d.cy} r="5" data-i={d.i} />)}
          </g>
          <g class="direct">
            {v.dots.filter((d) => d.label).map((d) => <text x={d.cx - 9} y={d.cy - 7} text-anchor="end">{d.label}</text>)}
          </g>
          <circle class="hover-ring" r="8" cx="-20" cy="-20" />
        </svg>
      ))
    }
    <script type="application/json" class="tips" set:html={tipsJson} />
    <div class="tip" hidden></div>
  </div>

  <p class="source" set:html={noteHtml} />

  <details class="table-view">
    <summary>{copy.charts.table_summary}</summary>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>{table.head.map((cell) => <th class:list={{ num: cell.num }}>{cell.label}</th>)}</tr>
        </thead>
        <tbody>
          {table.rows.map((row) => (
            <tr>{row.map((cell, i) => <td class:list={{ num: table.head[i].num }}>{cell}</td>)}</tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
</figure>
