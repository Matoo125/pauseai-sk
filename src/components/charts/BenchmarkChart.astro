---
// Benchmarks scored as a share of questions answered correctly (FrontierMath, GPQA Diamond,
// Humanity's Last Exam). One point per model, its best reasoning setting.
import ScatterChart from './ScatterChart.astro';
import data from '../../data/benchmarks.json';
import { records, skDate, skDecimal, yearOf } from '../../lib/chart';
import { copy, plain, rich, sourceLine } from '../../lib/copy';

interface Props {
  name: 'frontiermath' | 'gpqa' | 'hle';
}
const { name } = Astro.props;
const text = copy.charts[name];
const { results, url } = data[name];
const percent = (share: number) => skDecimal(share * 100, 0);

const isRecord = records(results.map((r) => r.score));
const latest = results.filter((_, i) => isRecord[i]).at(-1)!;
// The headline compares the best score by the end of the first year with the best today.
const firstYear = results[0].date.slice(0, 4);
const firstBest = Math.max(...results.filter((r) => r.date.startsWith(firstYear)).map((r) => r.score));
const vars = { first_year: firstYear, first: percent(firstBest), last: percent(latest.score), model: latest.name, url };
const reference = text.reference
  ? { value: Number(text.reference.value), label: plain(text.reference.label, vars) }
  : undefined;
---

<ScatterChart
  title={plain(text.title, vars)}
  subtitle={plain(text.subtitle, vars)}
  legendRecord={copy.charts.legend_record}
  legendOther={copy.charts.legend_other}
  aria={plain(text.aria, vars)}
  noteHtml={`${rich(text.note, vars)} ${sourceLine(data.source)}`}
  points={results.map((r) => ({
    name: r.name,
    date: r.date,
    value: r.score * 100,
    tip: {
      title: r.name,
      rows: [[copy.charts.score, `${percent(r.score)} %`], [copy.charts.org, r.org], [copy.charts.date, skDate(r.date)]],
    },
  }))}
  labels={{ [latest.name]: latest.name }}
  reference={reference}
  yDomain={[0, 100]}
  ticks={[0, 25, 50, 75, 100].map((value) => ({ value, label: `${value} %` }))}
  ticksNarrow={[0, 50, 100].map((value) => ({ value, label: `${value} %` }))}
  xDomain={[Number(firstYear), Math.ceil(yearOf(latest.date) + 0.25)]}
  table={{
    head: [{ label: copy.charts.model }, { label: copy.charts.org }, { label: copy.charts.date }, { label: copy.charts.score, num: true }],
    rows: results.map((r) => [r.name, r.org, skDate(r.date), `${percent(r.score)} %`]),
  }}
/>
