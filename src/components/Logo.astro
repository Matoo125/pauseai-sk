---
// The pause mark as it appears on the movement's placards, plus the wordmark.
import { copy } from '../lib/copy';

interface Props {
  /** 'on-orange' flips the mark to a white disc with orange bars. */
  tone?: 'on-orange' | 'on-white';
}
const { tone = 'on-white' } = Astro.props;
---

<a href="/" class:list={['logo', `logo-${tone}`]} aria-label={copy.site.logo_label}>
  <svg viewBox="0 0 32 32" aria-hidden="true">
    <circle class="logo-disc" cx="16" cy="16" r="16"></circle>
    <rect class="logo-bar" x="10" y="9" width="4.5" height="14"></rect>
    <rect class="logo-bar" x="17.5" y="9" width="4.5" height="14"></rect>
  </svg>
  <span class="logo-word">PauseAI <span class="logo-place">Slovensko</span></span>
</a>
