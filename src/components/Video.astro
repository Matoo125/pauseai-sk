---
// A YouTube video behind a still image. Nothing is requested from YouTube until
// the visitor presses play, so the page stays free of third-party requests.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { copy } from '../lib/copy';

interface Props {
  youtube: string;
  start: number;
  poster: ImageMetadata;
  caption: string;
  credit: string;
  credit_url: string;
}
const { youtube, start, poster, caption, credit, credit_url } = Astro.props;
const text = copy.evidence_page;
const embed = `https://www.youtube-nocookie.com/embed/${youtube}?autoplay=1&start=${start}&rel=0`;
const watch = `https://www.youtube.com/watch?v=${youtube}&t=${start}s`;
---

<figure class="video">
  <div class="video-frame">
    <button type="button" class="video-play" data-embed={embed} data-title={caption}>
      <Image src={poster} alt="" widths={[480, 800, 1280]} sizes="(max-width: 800px) 100vw, 720px" />
      <span class="video-button">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
        {text.video_play}
      </span>
    </button>
  </div>
  <figcaption>
    {caption} <a href={credit_url}>{credit}</a>. {text.video_note}
    <noscript><a href={watch}>YouTube</a></noscript>
  </figcaption>
</figure>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('.video-play')) {
    button.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = button.dataset.embed!;
      frame.title = button.dataset.title!;
      frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      frame.allowFullscreen = true;
      button.replaceWith(frame);
      frame.focus();
    });
  }
</script>
