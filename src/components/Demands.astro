---
import { getCollection } from 'astro:content';
import { copy, rich } from '../lib/copy';

const { demands, risks } = copy;

const sources = new Map((await getCollection('zdroje')).map((entry) => [entry.id, entry.data.title]));
const riskItems = risks.items.map((risk) => {
  if (risk.source && !sources.has(risk.source)) {
    throw new Error(`sk.yaml: risk "${risk.title}" points to source "${risk.source}", which is not in src/content/zdroje/`);
  }
  return { ...risk, sourceTitle: risk.source ? sources.get(risk.source)!.split(':')[0] : undefined };
});
---

<section class="band" id="poziadavky">
  <div class="wrap">
    <header class="band-head">
      <h2>{demands.heading}</h2>
      <p>{demands.intro}</p>
    </header>
    <ol class="demands">
      {
        demands.items.map((demand) => (
          <li>
            <h3>{demand.title}</h3>
            <p>{demand.text}</p>
            {demand.basis && <p class="basis" set:html={rich(demand.basis)} />}
          </li>
        ))
      }
    </ol>
    <p class="evidence-more" set:html={rich(demands.more)} />
  </div>
</section>

<section class="band band-tint" id="rizika">
  <div class="wrap">
    <header class="band-head">
      <h2>{risks.heading}</h2>
      <p>{risks.intro}</p>
    </header>
    <ul class="risks">
      {
        riskItems.map((risk) => (
          <li>
            <h3>{risk.title}</h3>
            <p>{risk.text}</p>
            {risk.source && (
              <p class="risk-source">
                {risks.read_more} <a href={`/zdroje/#${risk.source}`}>{risk.sourceTitle}</a>
              </p>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>
