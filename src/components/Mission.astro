---
import { copy, rich } from '../lib/copy';

const { mission } = copy;
---

<section class="band band-tint" id="poslanie">
  <div class="wrap mission">
    <div>
      <h2>{mission.heading}</h2>
      {mission.paragraphs.map((paragraph) => <p set:html={rich(paragraph)} />)}
    </div>

    <figure class="statement">
      <blockquote>
        <p>{mission.quote}</p>
      </blockquote>
      <figcaption set:html={rich(mission.quote_source)} />
    </figure>
  </div>
</section>
