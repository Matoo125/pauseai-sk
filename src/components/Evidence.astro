---
// The landing page's evidence in brief: the task-horizon chart (linear axis, so the
// doubling reads as a curve shooting up), what the Slovak
// public thinks, and the experts' risk statement. The full set is on /informacie/.
import HorizonChart from './charts/HorizonChart.astro';
import ChartTips from './charts/ChartTips.astro';
import Figures from './Figures.astro';
import { copy, rich } from '../lib/copy';

const text = copy.home_evidence;
---

<section class="band" id="data">
  <div class="wrap">
    <header class="band-head">
      <h2>{text.heading}</h2>
      <p>{text.intro}</p>
    </header>

    <HorizonChart linear />

    <div class="evidence-row">
      <div>
        <h3>{text.public.heading}</h3>
        <Figures items={text.public.figures} />
        <p class="source" set:html={rich(text.public.source)} />
      </div>

      <figure class="statement">
        <blockquote>
          <p>{text.quote}</p>
        </blockquote>
        <figcaption set:html={rich(text.quote_source)} />
      </figure>
    </div>

    <p class="evidence-more" set:html={rich(text.more)} />
  </div>
</section>

<ChartTips />
