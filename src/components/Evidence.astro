---
import ComputeChart from './ComputeChart.astro';
import SectorChart from './SectorChart.astro';
import ChartTips from './ChartTips.astro';
import { copy, plain, rich } from '../lib/copy';

const { evidence } = copy;
---

<section class="band" id="data">
  <div class="wrap">
    <header class="band-head">
      <h2>{evidence.heading}</h2>
      <p>{evidence.intro}</p>
    </header>

    <ComputeChart />

    <div class="evidence-row">
      <SectorChart />

      <div class="survey">
        <h3>{evidence.survey.heading}</h3>
        <dl>
          {
            evidence.survey.items.map((item) => (
              <div>
                <dt>{plain(item.figure)}</dt>
                <dd>{plain(item.text)}</dd>
              </div>
            ))
          }
        </dl>
        <p class="source" set:html={rich(evidence.survey.source)} />
      </div>
    </div>

    <p class="evidence-more" set:html={rich(evidence.more)} />
  </div>
</section>

<ChartTips />
