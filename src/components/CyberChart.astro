---
// Cybench: share of professional capture-the-flag tasks each model solved
// without hints, by release date. Same two-variant approach as ComputeChart.
import cybench from '../data/cybench.json';
import { scale, skDate, skDecimal, yearOf, type Tip } from '../lib/chart';
import { copy, plain, rich } from '../lib/copy';

const text = copy.security.chart;
const { results } = cybench;

const percent = (share: number) => skDecimal(share * 100, Number.isInteger(+(share * 100).toFixed(1)) ? 0 : 1);

let best = 0;
const isRecord = results.map((r) => (r.solved > best ? ((best = r.solved), true) : false));
const records = results.filter((_, i) => isRecord[i]);
const latest = records.at(-1)!;
const firstYear = results[0].date.slice(0, 4);
const firstYearBest = Math.max(...results.filter((r) => r.date.startsWith(firstYear)).map((r) => r.solved));

const vars = {
  first_year: firstYear,
  first: percent(firstYearBest),
  last: percent(latest.solved),
  last_date: skDate(latest.date),
  model: latest.name,
  count: results.length,
};
const sourceLine = rich(copy.evidence.source_line, {
  name: cybench.source.name,
  url: cybench.source.url,
  licence: cybench.source.licence,
  date: skDate(cybench.source.retrieved),
});

const tips: Tip[] = results.map((r) => ({
  title: r.name,
  rows: [
    [text.columns.solved, `${percent(r.solved)} %`],
    [text.columns.org, r.org],
    [text.columns.date, skDate(r.date)],
    [text.columns.reported, r.reportedBy],
  ],
}));
const tipsJson = JSON.stringify(tips).replace(/</g, '\\u003c');

const x0 = Number(firstYear);
const x1 = Math.ceil(yearOf(latest.date) + 0.25);
const ticks = [0, 25, 50, 75, 100];

const variants = [
  { id: 'wide', w: 960, h: 420, left: 56, right: 20, top: 18, bottom: 34 },
  { id: 'narrow', w: 340, h: 340, left: 46, right: 10, top: 16, bottom: 32 },
].map((v) => {
  const x = scale(x0, x1, v.left, v.w - v.right);
  const y = scale(0, 100, v.h - v.bottom, v.top);
  const years = [];
  for (let year = x0; year <= x1; year++) years.push(year);
  const dots = results.map((r, i) => ({
    i,
    cx: +x(yearOf(r.date)).toFixed(1),
    cy: +y(r.solved * 100).toFixed(1),
    record: isRecord[i],
    label: r === latest ? r.name : undefined,
  }));
  const frontier = dots
    .filter((d) => d.record)
    .map((d, i) => (i === 0 ? `M${d.cx},${d.cy}` : `H${d.cx}V${d.cy}`))
    .join('');
  return { ...v, x, y, years, dots, frontier };
});
---

<figure class="chart">
  <figcaption>
    <h3>{plain(text.title, vars)}</h3>
    <p>{plain(text.subtitle, vars)}</p>
  </figcaption>

  <ul class="legend">
    <li><span class="key key-dot key-record"></span>{text.legend_record}</li>
    <li><span class="key key-dot key-other"></span>{text.legend_other}</li>
  </ul>

  <div class="plot" data-plot="nearest">
    {
      variants.map((v) => (
        <svg class={`variant-${v.id}`} viewBox={`0 0 ${v.w} ${v.h}`} role="img" aria-label={plain(text.aria, vars)}>
          <g class="grid">
            {ticks.map((tick) => <line x1={v.left} x2={v.w - v.right} y1={v.y(tick)} y2={v.y(tick)} />)}
          </g>
          <g class="axis">
            {ticks.map((tick) => <text x={v.left - 8} y={v.y(tick) + 5} text-anchor="end">{tick} %</text>)}
            {v.years.map((year) => <text x={v.x(year)} y={v.h - 10} text-anchor="middle">{year}</text>)}
          </g>
          <g class="dots-other">
            {v.dots.filter((d) => !d.record).map((d) => <circle cx={d.cx} cy={d.cy} r="4" data-i={d.i} />)}
          </g>
          <path class="frontier" d={v.frontier} />
          <g class="dots-record">
            {v.dots.filter((d) => d.record).map((d) => <circle cx={d.cx} cy={d.cy} r="5" data-i={d.i} />)}
          </g>
          <g class="direct">
            {v.dots.filter((d) => d.label).map((d) => (
              <text x={d.cx - 9} y={d.cy - 7} text-anchor="end">{d.label}</text>
            ))}
          </g>
          <circle class="hover-ring" r="8" cx="-20" cy="-20" />
        </svg>
      ))
    }
    <script type="application/json" class="tips" set:html={tipsJson} />
    <div class="tip" hidden></div>
  </div>

  <p class="source">{plain(text.note, vars)} <Fragment set:html={sourceLine} /></p>

  <details class="table-view">
    <summary>{text.table_summary}</summary>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th>{text.columns.model}</th><th>{text.columns.org}</th><th>{text.columns.date}</th>
            <th class="num">{text.columns.solved}</th><th>{text.columns.reported}</th>
          </tr>
        </thead>
        <tbody>
          {results.map((r) => (
            <tr>
              <td>{r.name}</td><td>{r.org}</td><td>{skDate(r.date)}</td>
              <td class="num">{percent(r.solved)} %</td><td>{r.reportedBy}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
</figure>
