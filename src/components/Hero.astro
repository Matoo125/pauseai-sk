---
import { Image } from 'astro:assets';
import crowd from '../assets/hero-crowd.jpeg';
import Logo from './Logo.astro';
import { nav } from '../data/site';
---

<div class="placard">
  <header class="wrap topbar">
    <Logo tone="on-orange" />
    <nav aria-label="Hlavná navigácia">
      {nav.map((item) => <a class="topbar-link" href={item.href}>{item.label}</a>)}
      <a class="button button-small" href="#vyzva">Podpísať výzvu</a>
    </nav>
  </header>

  <section class="wrap hero">
    <h1><span>Budúcnosť tvoríme my.</span> <span>Nie nekontrolované preteky algoritmov.</span></h1>
    <div class="hero-row">
      <div class="hero-text">
        <p>
          PauseAI Slovensko spája vedcov, vývojárov, rodičov a občanov, ktorí žiadajú zodpovedné tempo,
          medzinárodný bezpečnostný dohľad a demokratickú kontrolu pred trénovaním najsilnejších modelov.
        </p>
        <div class="hero-actions">
          <a class="button" href="#vyzva">Podpísať výzvu</a>
          <a class="text-link" href="#data">Pozrieť dáta</a>
        </div>
        <p class="hero-note">Súčasť celosvetového hnutia PauseAI, ktoré vzniklo v roku 2023.</p>
      </div>
      <Image
        class="hero-photo"
        src={crowd}
        alt="Ľudia na zhromaždení PauseAI držia oranžové transparenty so symbolom pauzy a nápismi proti nekontrolovanému vývoju AI."
        widths={[480, 800, 1200]}
        sizes="(max-width: 800px) 100vw, 560px"
        loading="eager"
      />
    </div>
  </section>
</div>
