---
import Topbar from './Topbar.astro';
import { copyFor, type Lang } from '../lib/copy';
import { joinHrefFor, thesisHref } from '../data/site';

interface Props {
  lang?: Lang;
}
const { lang = 'sk' } = Astro.props;
const { hero } = copyFor(lang);
---

<div class="placard">
  <Topbar lang={lang} />

  <section class="wrap hero">
    <h1>{hero.title.map((line) => <span>{line} </span>)}</h1>
    <div class="hero-row">
      <div class="hero-text">
        <p>{hero.lead}</p>
        <div class="hero-actions">
          <a class="button" href={thesisHref}>{hero.cta}</a>
          {hero.cta_about && <a class="text-link" href="/kto-sme/#praca">{hero.cta_about}</a>}
        </div>
        <p class="hero-note">{hero.note}</p>
        <p class="hero-note hero-join">
          {hero.movement} <a href={joinHrefFor(lang)}>{hero.cta_join}</a>
        </p>
      </div>
      <!-- Decorative: the plug animation by PauseAI Österreich, see src/scripts/plug.js. -->
      <div class="plug" aria-hidden="true"></div>
    </div>
  </section>
</div>

<script>
  import '../scripts/plug.js';
</script>
