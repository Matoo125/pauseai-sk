---
// Sign-up form (to Formspree) plus a pointer to the international statement,
// which is signed on pauseai.info, not here.
import { copyFor, rich, type Lang } from '../lib/copy';
import { formEndpoint, whatsappHref } from '../data/site';

interface Props {
  lang?: Lang;
}
const { join } = copyFor(Astro.props.lang);
const { form, statement, whatsapp } = join;
const messages = {
  sending: form.sending,
  done: form.done,
  success: form.success,
  successVolunteer: form.success_volunteer,
  error: form.error,
};
---

<section class="band band-dark" id="pridaj-sa">
  <div class="wrap join">
    <div class="join-text join-head">
      <h2>{join.heading}</h2>
      <p>{join.text}</p>
      {
        whatsappHref && (
          <div class="join-whatsapp">
            <h3>{whatsapp.heading}</h3>
            <p>{whatsapp.text}</p>
            <a class="button button-orange" href={whatsappHref} rel="noopener">{whatsapp.button}</a>
          </div>
        )
      }
    </div>

    <details class="join-text join-statement">
      <summary>{statement.heading}</summary>
      <p>{statement.text}</p>
      <a class="button button-orange" href={statement.url} rel="noopener">{statement.button}</a>
      <p class="join-small" set:html={rich(statement.also)} />
    </details>

    <form id="join-form" class="form" action={formEndpoint} method="POST" data-messages={JSON.stringify(messages)}>
      <h3>{form.heading}</h3>

      <label for="join-name">{form.name}</label>
      <input id="join-name" name="name" type="text" autocomplete="name" placeholder={form.name_placeholder} required />

      <label for="join-email">{form.email}</label>
      <input id="join-email" name="email" type="email" autocomplete="email" placeholder={form.email_placeholder} required />

      <label for="join-phone">{form.phone}</label>
      <input id="join-phone" name="phone" type="tel" autocomplete="tel" placeholder={form.phone_placeholder} />

      <label for="join-role">{form.role}</label>
      <input id="join-role" name="role" type="text" placeholder={form.role_placeholder} />

      <label class="check">
        <input name="volunteer" type="checkbox" />
        <span>{form.volunteer}</span>
      </label>

      <input type="hidden" name="_subject" value={form.mail_subject} />

      <button class="button" type="submit">{form.button}</button>
      <p class="form-status" role="status" hidden></p>
      <!-- A tooltip that opens on click, so it also works on phones and its link can be followed. -->
      <details class="form-tip">
        <summary>{form.privacy_label}</summary>
        <div class="form-tip-box">
          <p>{form.privacy}</p>
          <p set:html={rich(join.contact)} />
        </div>
      </details>
    </form>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('#join-form')!;
  const status = form.querySelector<HTMLElement>('.form-status')!;
  const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  const messages: Record<string, string> = JSON.parse(form.dataset.messages!);
  const idle = button.textContent!;

  const say = (kind: 'ok' | 'error', text: string) => {
    status.hidden = false;
    status.dataset.kind = kind;
    status.textContent = text;
  };

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const name = String(data.get('name') ?? '').trim() || String(data.get('email'));
    const volunteer = data.has('volunteer');

    button.disabled = true;
    button.textContent = messages.sending;
    status.hidden = true;

    try {
      const response = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
      if (!response.ok) throw new Error(String(response.status));
      say('ok', (volunteer ? messages.successVolunteer : messages.success).replace('{name}', name));
      form.reset();
      button.textContent = messages.done;
    } catch {
      say('error', messages.error);
      button.disabled = false;
      button.textContent = idle;
    }
  });
</script>
