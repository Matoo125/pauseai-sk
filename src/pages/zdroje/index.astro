---
// The reading list: every entry of src/content/zdroje/, grouped by kind of text.
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Topbar from '../../components/Topbar.astro';
import Footer from '../../components/Footer.astro';
import { copy, rich } from '../../lib/copy';

const text = copy.sources;
const entries = await getCollection('zdroje');
const groups = await Promise.all(
  (Object.keys(text.kinds) as (keyof typeof text.kinds)[]).map(async (kind) => ({
    kind,
    heading: text.kinds[kind],
    items: await Promise.all(
      entries
        .filter((entry) => entry.data.kind === kind)
        .sort((a, b) => a.data.order - b.data.order)
        .map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
    ),
  })),
);
---

<Base title={text.title} description={text.description}>
  <div class="placard">
    <Topbar />
    <div class="wrap page-head">
      <h1>{text.heading}</h1>
      <p>{text.intro}</p>
    </div>
  </div>

  <main id="obsah" class="band">
    <div class="wrap">
      {
        groups.filter((group) => group.items.length).map((group) => (
          <section class="source-group">
            <h2>{group.heading}</h2>
            {group.items.map(({ entry, Content }) => (
              <article class="source-entry" id={entry.id}>
                <header>
                  <h3>{entry.data.title}</h3>
                  <p class="source-byline">{entry.data.authors}, {entry.data.year}</p>
                </header>
                <div class="source-body">
                  <p class="source-claim"><strong>{text.claim_label}:</strong> {entry.data.claim}</p>
                  <Content />
                  <p class="source-format">{entry.data.format}</p>
                  <a class="text-link" href={entry.data.url} rel="noopener">{text.open}</a>
                </div>
              </article>
            ))}
          </section>
        ))
      }

      <section class="disagree">
        <h2>{text.disagree.heading}</h2>
        {text.disagree.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </section>

      <p class="evidence-more" set:html={rich(text.data_note)} />
    </div>
  </main>
  <Footer />
</Base>
