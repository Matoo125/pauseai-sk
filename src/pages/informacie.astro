---
// /informacie/: every claim in src/content/tvrdenia/, each with its charts, figures, context
// and sources, followed by the reading list from src/content/zdroje/.
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Page from '../components/Page.astro';
import Figures from '../components/Figures.astro';
import Video from '../components/Video.astro';
import ChartTips from '../components/charts/ChartTips.astro';
import HorizonChart from '../components/charts/HorizonChart.astro';
import ComputeChart from '../components/charts/ComputeChart.astro';
import CybenchChart from '../components/charts/CybenchChart.astro';
import BenchmarkChart from '../components/charts/BenchmarkChart.astro';
import SectorChart from '../components/charts/SectorChart.astro';
import InvestmentChart from '../components/charts/InvestmentChart.astro';
import { copy, rich } from '../lib/copy';
import { feedbackHref } from '../data/site';

const text = copy.evidence_page;
// Scatter charts need the full width, so two of them share it as tabs.
// Column charts are drawn narrow, so two of them sit side by side.
const CHARTS = {
  horizon: { Chart: HorizonChart, narrow: false },
  compute: { Chart: ComputeChart, narrow: false },
  frontiermath: { Chart: BenchmarkChart, props: { name: 'frontiermath' }, narrow: false },
  gpqa: { Chart: BenchmarkChart, props: { name: 'gpqa' }, narrow: false },
  hle: { Chart: BenchmarkChart, props: { name: 'hle' }, narrow: false },
  cybench: { Chart: CybenchChart, narrow: false },
  sectors: { Chart: SectorChart, narrow: true },
  investment: { Chart: InvestmentChart, narrow: true },
};

const claims = await Promise.all(
  (await getCollection('tvrdenia'))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (entry) => ({
      entry,
      Content: (await render(entry)).Content,
      charts: entry.data.charts.map((name) => ({ ...CHARTS[name], name, tab: copy.charts[name].tab as string })),
      tabbed: entry.data.charts.length > 1 && !entry.data.charts.every((name) => CHARTS[name].narrow),
    })),
);

const KIND_ORDER = ['report', 'argument', 'book'];
const reading = (await getCollection('zdroje')).sort(
  (a, b) => KIND_ORDER.indexOf(a.data.kind) - KIND_ORDER.indexOf(b.data.kind) || a.data.order - b.data.order,
);
---

<Page heading={text.heading} lead={text.lead} description={text.description}>
  <div class="with-sidebar">
  <nav class="contents" aria-label={text.contents}>
    <p class="contents-title">{text.contents}</p>
    <ol>
      {claims.map(({ entry }) => <li><a href={`#${entry.id}`}>{entry.data.title}</a></li>)}
      <li><a href="#citanie">{text.reading.heading}</a></li>
    </ol>
  </nav>

  <div class="claims">
  {
    claims.map(({ entry, Content, charts, tabbed }) => (
      <section class="claim" id={entry.id}>
        <h2>{entry.data.title}</h2>
        {charts.length > 0 && !tabbed && (
          <div class:list={['claim-charts', { 'claim-charts-pair': charts.length === 2 }]}>
            {charts.map(({ Chart, props }) => <Chart {...props} />)}
          </div>
        )}
        {tabbed && (
          <div class="claim-charts tabs">
            <div class="tab-list" role="tablist" aria-label={text.tabs_label}>
              {charts.map((chart, i) => (
                <button
                  type="button"
                  role="tab"
                  id={`${entry.id}-tab-${chart.name}`}
                  aria-controls={`${entry.id}-panel-${chart.name}`}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  tabindex={i === 0 ? 0 : -1}
                >
                  {chart.tab}
                </button>
              ))}
            </div>
            {charts.map(({ Chart, name, props }) => (
              <div class="tab-panel" role="tabpanel" id={`${entry.id}-panel-${name}`} aria-labelledby={`${entry.id}-tab-${name}`}>
                <Chart {...props} />
              </div>
            ))}
          </div>
        )}
        {entry.data.figures.length > 0 && <Figures items={entry.data.figures} />}
        {entry.data.video && <Video {...entry.data.video} />}
        <div class="prose">
          <Content />
        </div>
        <p class="claim-sources">
          {text.sources}{' '}
          {entry.data.sources.map((source, i) => (
            <Fragment>{i > 0 && '; '}<a href={source.url}>{source.label}</a></Fragment>
          ))}
        </p>
        <p class="claim-feedback" set:html={rich(text.feedback, { url: `${feedbackHref}?k=${encodeURIComponent(`/informacie/#${entry.id}`)}` })} />
      </section>
    ))
  }

  <section class="claim" id="citanie">
    <h2>{text.reading.heading}</h2>
    <p class="reading-intro">{text.reading.intro}</p>
    <ul class="reading">
      {
        reading.map((entry) => (
          <li id={entry.id}>
            {entry.data.cover ? (
              <Image class="reading-cover" src={entry.data.cover} alt="" width={132} densities={[1, 2]} title={entry.data.cover_credit} />
            ) : (
              <span class="reading-cover reading-cover-none" />
            )}
            <div>
              <p class="reading-kind">{text.reading.kinds[entry.data.kind]}</p>
              <h3><a href={entry.data.url} rel="noopener">{entry.data.title}</a></h3>
              <p class="reading-byline">{entry.data.authors}, {entry.data.year}</p>
              <p>{entry.data.claim}</p>
              <p class="reading-format">
                {entry.data.format}
                {entry.data.cover_credit && ` ${entry.data.cover_credit}.`}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
    <p class="reading-intro">{text.reading.disagree}</p>
  </section>
  </div>
  </div>

  <ChartTips />
</Page>

<script>
  // Tabs. Without JavaScript every panel simply shows, one under the other.
  for (const tabs of document.querySelectorAll<HTMLElement>('.tabs')) {
    const buttons = [...tabs.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (chosen: HTMLButtonElement, focus = false) => {
      for (const button of buttons) {
        const on = button === chosen;
        button.setAttribute('aria-selected', String(on));
        button.tabIndex = on ? 0 : -1;
        document.getElementById(button.getAttribute('aria-controls')!)!.hidden = !on;
      }
      if (focus) chosen.focus();
    };
    select(buttons[0]);
    buttons.forEach((button, i) => {
      button.addEventListener('click', () => select(button));
      button.addEventListener('keydown', (event) => {
        const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        event.preventDefault();
        select(buttons[(i + step + buttons.length) % buttons.length], true);
      });
    });
  }

  // Mark the section being read in the side menu.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('.contents a')].map((link) => [link.hash.slice(1), link]),
  );
  const visible = new Set<string>();
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) visible.add(entry.target.id);
        else visible.delete(entry.target.id);
      }
      // The first section on screen, in page order, is the current one.
      const current = [...links.keys()].find((id) => visible.has(id));
      for (const [id, link] of links) {
        if (id === current) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      }
    },
    { rootMargin: '-10% 0px -40% 0px' },
  );
  for (const id of links.keys()) {
    const section = document.getElementById(id);
    if (section) observer.observe(section);
  }
</script>
